#!/bin/bash
# Deterministic gh shim for delivery tests.
set -euo pipefail
[ -z "${GH_LOG:-}" ] || printf '%s\n' "$*" >>"$GH_LOG"
case "$1 $2" in
  'pr list')
    if [ "${GH_MODE:-success}" = pr_exists ]; then printf 'https://example.test/existing\n'; fi
    ;;
  'pr create')
    if [ "${GH_MODE:-success}" = create_fail ]; then exit 4; fi
    printf 'https://example.test/new\n'
    ;;
  *) exit 2 ;;
esac
