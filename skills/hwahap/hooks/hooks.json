{
  "description": "Hwahap v2 lifecycle hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "/bin/bash \"$HOME/.codex/skills/hwahap/hooks/prompt.sh\""}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {"type": "command", "command": "/bin/bash \"$HOME/.codex/skills/hwahap/hooks/pretool.sh\""}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {"type": "command", "command": "/bin/bash \"$HOME/.codex/skills/hwahap/hooks/posttool.sh\""}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "/bin/bash \"$HOME/.codex/skills/hwahap/hooks/gate.sh\""}
        ]
      }
    ]
  }
}
